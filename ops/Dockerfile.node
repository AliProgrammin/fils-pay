# Image for the Node services in ops/docker-compose.yml: api, reporting and
# the one-off migrate and seed jobs. Each service sets its own `command:`.
# Build context is the repo root.
FROM node:22-bookworm-slim

WORKDIR /app

# Install workspace dependencies first so this layer is cached until a
# manifest changes. Native modules (argon2, sharp) install their Linux builds.
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY apps/reporting/package.json apps/reporting/
COPY apps/web/package.json apps/web/
COPY apps/admin/package.json apps/admin/
COPY packages/events/package.json packages/events/
COPY packages/money/package.json packages/money/
RUN npm ci --no-audit --no-fund

COPY . .

CMD ["npx", "tsx", "apps/api/src/index.ts"]

# apps/web and apps/admin, built once and served by nginx on ONE origin
# (see ops/nginx/filspay.conf). Build context is the repo root.
#
# The VITE_* URLs default to the same origin: an empty API base makes the
# apps call relative paths (/v1/...), which nginx proxies to the api.
FROM node:22-bookworm-slim AS build
WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY apps/reporting/package.json apps/reporting/
COPY apps/web/package.json apps/web/
COPY apps/admin/package.json apps/admin/
COPY packages/events/package.json packages/events/
COPY packages/money/package.json packages/money/
RUN npm ci --no-audit --no-fund

COPY tsconfig.base.json ./
COPY packages/ packages/
COPY apps/web/ apps/web/
COPY apps/admin/ apps/admin/

ARG VITE_API_BASE_URL=""
ARG VITE_ADMIN_API_BASE_URL=""
ARG VITE_WEB_BASE_URL="/dashboard"
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL \
    VITE_ADMIN_API_BASE_URL=$VITE_ADMIN_API_BASE_URL \
    VITE_WEB_BASE_URL=$VITE_WEB_BASE_URL

RUN cd apps/web && npx vite build --outDir /out/web \
 && cd ../admin && npx vite build --base=/admin/ --outDir /out/admin

FROM nginx:1.27-alpine
COPY ops/nginx/filspay.conf /etc/nginx/conf.d/default.conf
COPY --from=build /out/web /usr/share/nginx/html
COPY --from=build /out/admin /usr/share/nginx/html/admin
EXPOSE 80

# FilsPay production / hosted-demo settings for ops/docker-compose.prod.yml.
#
#   cp ops/.env.production.example ops/.env.production
#
# Then replace every CHANGE_ME. ops/.env.production is gitignored: never
# commit it. Each secret line shows the command that makes a strong value.
# NODE_ENV=production is set by the compose file itself.

# ---- Database -------------------------------------------------------------
# Password of the `filspay` Postgres role. Hex only, so it is safe in a URL.
#   openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME

# Must use the SAME password as POSTGRES_PASSWORD above. Host `postgres` is
# the compose service; traffic stays on the internal Docker network.
DATABASE_URL=postgres://filspay:CHANGE_ME@postgres:5432/filspay?sslmode=disable

# ---- Secrets (all required when NODE_ENV=production) ----------------------
# Bearer token between the api and the settlement daemon (both read it).
#   openssl rand -hex 32
SETTLEMENT_INTERNAL_TOKEN=CHANGE_ME

# Shared secret the acquirer signs its callbacks with.
#   openssl rand -hex 32
ACQUIRER_CALLBACK_SIGNING_SECRET=CHANGE_ME

# AES-256 key for stored webhook secrets: base64 of exactly 32 bytes.
# Do not change it after the first start, or stored webhook secrets
# can no longer be decrypted.
#   openssl rand -base64 32
WEBHOOK_SECRET_ENCRYPTION_KEY=CHANGE_ME

# ---- Public URL -----------------------------------------------------------
# The address people use to open the app (no trailing slash). Used to build
# payment-link URLs (<this>/pay/<token>).
CHECKOUT_BASE_URL=https://filspay.example.com

# ---- Cookies --------------------------------------------------------------
# Keep true when the site is served over HTTPS (real hosting).
# Set false ONLY for local testing over plain http, or browsers and curl
# will drop the session cookie and login will not stick.
COOKIE_SECURE=true

# ---- OTP (DEMO ONLY) ------------------------------------------------------
# There is no real OTP delivery (no email or SMS); codes are never sent.
# true = the login response includes the code and the login page shows it,
# so judges can sign in. This is a DEMO-ONLY setting: anyone with a
# password can then pass the second factor. Set false for a real launch,
# after real OTP delivery exists.
OTP_DEV_EXPOSE=true

# ---- Optional -------------------------------------------------------------
# Simulated acquirer: share of authorizations that fail on purpose (0..1).
# ACQUIRER_FAILURE_RATE=0.02
